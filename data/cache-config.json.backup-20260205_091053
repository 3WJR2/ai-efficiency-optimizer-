{
  "version": "1.0.0",
  "prompt_caching_enabled": true,
  "semantic_caching_enabled": true,
  "redis_host": "localhost",
  "redis_port": 6379,
  "cache_ttl_seconds": 86400,
  "similarity_threshold": 0.80,
  "embedding_provider": "anthropic",
  "max_cache_size_mb": 100,
  "feature_flags": {
    "enable_cache": true,
    "enable_metrics": true,
    "enable_debug_logging": false
  },
  "cost_per_1k_tokens": {
    "input": 0.003,
    "output": 0.015,
    "cached_input": 0.0003
  }
}
