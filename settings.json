  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" start 2>/dev/null || true",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code context 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/on-session-start.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/capture-interaction.sh \"$CLAUDE_USER_PROMPT\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/outcome-tracker.sh track-interaction 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code session-init 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/pattern-analyzer.sh analyze 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/adaptive-config-manager.sh update 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code observation 2>/dev/null || true",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/preserve-session-context.sh 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/analyze-interaction-patterns.sh 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code summarize 2>/dev/null || true",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "_R=\"$HOME/.claude/plugins/marketplaces/thedotmack/plugin\"; node \"$_R/scripts/bun-runner.js\" \"$_R/scripts/worker-service.cjs\" hook claude-code session-complete 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
